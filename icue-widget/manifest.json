    { "platform": "windows" }
  ],
  "supported_devices": [
    { "type": "dashboard_lcd", "features": ["sensor-screen"] }
  ],
  "interactive": true,
  "permissions": [
    { "type": "url", "domain": "localhost", "port": 47821 }
  ]
}
